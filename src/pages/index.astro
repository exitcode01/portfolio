<script define:vars={{ terminalLines }}>
	const body = document.getElementById('term-body');

	const colorMap = {
		dollar:  { before: '<span class="t-dollar">$ </span><span class="t-cmd">', after: '</span>' },
		muted:   { before: '<span class="t-muted">', after: '</span>' },
		label:   { before: '<span class="t-label">', after: '</span>' },
		success: { before: '<span class="t-success">', after: '</span>' },
		comment: { before: '<span class="t-comment">', after: '</span>' },
		output:  { before: '<span class="t-output">', after: '</span>' },
		added:   { before: '<span class="t-added">', after: '</span>' },
		removed: { before: '<span class="t-removed">', after: '</span>' },
		plain:   { before: '', after: '' },
	};

	function escHtml(s) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	function addLine(text, cls) {
		const span = document.createElement('span');
		span.className = 'term-line';
		const map = colorMap[cls] || colorMap.plain;
		span.innerHTML = text === '' ? '&nbsp;' : map.before + escHtml(text) + map.after;
		body.appendChild(span);
		body.scrollTop = body.scrollHeight;
	}

	function runLines(index = 0) {
		if (index >= terminalLines.length) {
			const cur = document.createElement('span');
			cur.className = 'term-line';
			cur.innerHTML = '<span class="t-dollar">$ </span><span class="t-cursor" aria-hidden="true"></span>';
			body.appendChild(cur);
			return;
		}
		const l = terminalLines[index];
		const pause = l.pause || 0;
		setTimeout(() => {
			addLine(l.text, l.cls);
			setTimeout(() => runLines(index + 1), 30);
		}, pause);
	}

	setTimeout(() => runLines(), 600);
</script>

<style>
	/* ── Page shell ── */
	.page {
		background: var(--hs-navy);
		color: var(--hs-off-white);
		font-family: var(--hs-font-display);
		position: relative;
		overflow: hidden;
	}

	.grid-bg {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--hs-border) 1px, transparent 1px),
			linear-gradient(90deg, var(--hs-border) 1px, transparent 1px);
		background-size: 40px 40px;
		pointer-events: none;
		mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 20%, transparent 80%);
		-webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 20%, transparent 80%);
	}

	/* ── Hero ── */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		padding: 3.5rem 3rem 2.5rem;
		position: relative;
		z-index: 1;
		align-items: start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.hero-left {
		display: flex;
		flex-direction: column;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--hs-font-mono);
		font-size: 11px;
		color: var(--hs-indigo);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 1.25rem;
	}

	.eyebrow-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--hs-indigo);
		animation: pulse-dot 2s ease-in-out infinite;
		flex-shrink: 0;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50%       { opacity: 0.4; transform: scale(0.7); }
	}

	.hero-name {
		font-family: var(--hs-font-display);
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--hs-off-white);
		margin: 0 0 0.5rem;
	}

	.hero-name .accent { color: var(--hs-indigo); }

	.hero-title {
		font-size: 1rem;
		color: var(--hs-slate-2);
		font-weight: 400;
		margin: 0 0 1.75rem;
		line-height: 1.5;
	}

	.hero-bio {
		font-size: 0.9rem;
		color: var(--hs-off-white-dim);
		line-height: 1.8;
		max-width: 36rem;
		margin: 0 0 1.75rem;
	}

	.hero-bio strong {
		color: var(--hs-off-white);
		font-weight: 600;
	}

	/* ── Tags ── */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 1.75rem;
	}

	.tag {
		font-family: var(--hs-font-mono);
		font-size: 10.5px;
		padding: 4px 10px;
		border-radius: 4px;
		border: 1px solid var(--hs-border);
		color: var(--hs-slate-2);
		background: var(--hs-navy-2);
		letter-spacing: 0.04em;
	}

	.tag.highlight {
		border-color: var(--hs-indigo-border);
		color: var(--hs-indigo);
		background: var(--hs-indigo-dim);
	}

	/* ── Buttons ── */
	.actions {
		display: flex;
		gap: 12px;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.btn {
		font-family: var(--hs-font-display);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		padding: 0.6rem 1.4rem;
		border-radius: 6px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.btn-primary {
		background: var(--hs-indigo);
		color: #fff;
		border: 1px solid var(--hs-indigo);
	}

	.btn-primary:hover { background: #3d5eee; border-color: #3d5eee; }

	.btn-ghost {
		background: transparent;
		color: var(--hs-slate-2);
		border: 1px solid var(--hs-border);
	}

	.btn-ghost:hover {
		border-color: var(--hs-indigo-border);
		color: var(--hs-indigo);
	}

	/* ── Socials ── */
	.socials {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.78rem;
		color: var(--hs-slate);
		text-decoration: none;
		font-family: var(--hs-font-mono);
		transition: color 0.15s ease;
	}

	.social-link:hover { color: var(--hs-indigo); }

	/* ── Documentation types (hero) ── */
	.doc-types-hero {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--hs-border);
	}

	.doc-types-label {
		font-family: var(--hs-font-mono);
		font-size: 11px;
		color: var(--hs-indigo);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	/* ── Terminal ── */
	.terminal-wrap { position: relative; }

	.terminal {
		background: var(--hs-term-bg);
		border: 1px solid var(--hs-term-border);
		border-radius: 10px;
		overflow: hidden;
		font-family: var(--hs-font-mono);
		font-size: 11.5px;
		line-height: 1.65;
		box-shadow: 0 20px 40px rgba(16, 19, 28, 0.12);
	}

	.term-bar {
		background: var(--hs-term-bg-2);
		padding: 10px 14px;
		display: flex;
		align-items: center;
		gap: 10px;
		border-bottom: 1px solid var(--hs-term-border);
	}

	.term-dots { display: flex; gap: 6px; }

	.term-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}

	.td-red   { background: #FF5F57; }
	.td-amber { background: #FEBC2E; }
	.td-green { background: #28C840; }

	.term-title {
		flex: 1;
		text-align: center;
		font-size: 10px;
		color: var(--hs-term-muted);
		letter-spacing: 0.05em;
	}

	.term-body {
		padding: 16px;
		min-height: 340px;
		display: flex;
		flex-direction: column;
		overflow-y: auto;
	}

	/* Terminal line colours */
	:global(.term-line)   { display: block; white-space: pre; }
	:global(.t-dollar)    { color: var(--hs-indigo); }
	:global(.t-cmd)       { color: var(--hs-term-fg-dim); }
	:global(.t-muted)     { color: var(--hs-term-muted); }
	:global(.t-label)     { color: var(--hs-indigo); font-weight: 500; }
	:global(.t-success)   { color: var(--hs-green); }
	:global(.t-comment)   { color: #3a4558; }
	:global(.t-output)    { color: var(--hs-term-fg); }
	:global(.t-added)     { color: var(--hs-green); }
	:global(.t-removed)   { color: var(--hs-red-term); }
	:global(.t-cursor) {
		display: inline-block;
		width: 7px;
		height: 13px;
		background: var(--hs-indigo);
		vertical-align: middle;
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50%       { opacity: 0; }
	}

	/* ── Stats row ── */
	.stats-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--hs-border);
		border-top: 1px solid var(--hs-border);
		border-bottom: 1px solid var(--hs-border);
		position: relative;
		z-index: 1;
	}

	.stat-cell {
		background: var(--hs-navy);
		padding: 1.5rem 3rem;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

