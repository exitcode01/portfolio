---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
	const photos = await getCollection('photos');
	return photos.map((photo) => ({
		params: { slug: photo.id },
		props: { photos },
	}));
}

const { slug } = Astro.params;
const { photos } = Astro.props;
const sorted = [...photos].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const current = sorted.find((p) => p.id === slug)!;

const lightboxPhotos = await Promise.all(
	sorted.map(async (p) => {
		const full = await getImage({ src: p.data.image, width: 1600 });
		return {
			slug: p.id,
			title: p.data.title,
			description: p.data.description ?? '',
			location: p.data.location ?? '',
			camera: p.data.camera ?? '',
			src: full.src,
			width: full.attributes.width,
			height: full.attributes.height,
		};
	}),
);
---

<GalleryLayout
	title={`${current.data.title} — Photography`}
	description={current.data.description}
>
	<p><a class="back-link" href={`${import.meta.env.BASE_URL}photography/`}>&larr; Back to gallery</a></p>
	<h1>{current.data.title}</h1>
	{current.data.description && <p class="intro">{current.data.description}</p>}
	<Image src={current.data.image} alt={current.data.title} width={1200} height={800} class="hero" />

	<Lightbox photos={lightboxPhotos} autoOpenSlug={slug} />
</GalleryLayout>

<style>
	.back-link {
		color: var(--gallery-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.back-link:hover {
		color: var(--brand-accent);
	}

	.intro {
		color: var(--gallery-muted);
	}

	.hero :global(img),
	img.hero {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		margin-top: 1rem;
	}
</style>
