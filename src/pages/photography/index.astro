---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import Lightbox from '../../components/Lightbox.astro';

const photos = (await getCollection('photos')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const lightboxPhotos = await Promise.all(
	photos.map(async (p) => {
		const full = await getImage({ src: p.data.image, width: 1600 });
		return {
			slug: p.id,
			title: p.data.title,
			description: p.data.description ?? '',
			location: p.data.location ?? '',
			camera: p.data.camera ?? '',
			src: full.src,
			width: full.attributes.width,
			height: full.attributes.height,
		};
	}),
);
---

<GalleryLayout title="Photography — Haressh S" description="A photography portfolio.">
	<h1>Photography</h1>
	<p class="intro">A selection of shots. Click any photo to view it larger.</p>

	<div class="grid">
		{
			photos.map((photo, index) => (
				<a
					href={`/photography/${photo.id}/`}
					class="thumb"
					data-lightbox-index={index}
					aria-label={`Open ${photo.data.title}`}
				>
					<Image
						src={photo.data.image}
						alt={photo.data.title}
						width={480}
						height={320}
						loading={index < 6 ? 'eager' : 'lazy'}
					/>
				</a>
			))
		}
	</div>

	<Lightbox photos={lightboxPhotos} />
</GalleryLayout>

<style>
	.intro {
		color: var(--gallery-muted);
		margin-top: -0.25rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.thumb {
		display: block;
		overflow: hidden;
		border-radius: 0.5rem;
		aspect-ratio: 3 / 2;
		box-shadow: 0 0 0 0 var(--brand-accent-soft);
		transition: box-shadow 0.2s ease;
	}

	.thumb:hover {
		box-shadow: 0 0 0 3px var(--brand-accent-soft);
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.2s ease;
	}

	.thumb:hover :global(img) {
		transform: scale(1.04);
	}
</style>
