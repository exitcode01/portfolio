---
const path = Astro.url.pathname;

const tabs = [
	{ label: 'About Me', href: '/' },
	{ label: 'Resume', href: '/resume/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Portfolio', href: '/portfolio/' },
	{ label: 'Photography', href: '/photography/' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="site-tabs" aria-label="Sections" data-pagefind-ignore>
	<div class="site-tabs-inner">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true"></span>
			Haressh S <span class="brand-role">/ Technical Writer</span>
		</a>
		<div class="tabs">
			{
				tabs.map((tab) => (
					<a href={tab.href} aria-current={isActive(tab.href) ? 'page' : undefined}>
						{tab.label}
					</a>
				))
			}
		</div>
	</div>
</nav>

<style>
	@layer starlight.core {
		.site-tabs {
			display: flex;
			align-items: center;
			height: 100%;
		}

		.site-tabs-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 0.75rem;
			max-width: 72rem;
			margin: 0 auto;
			width: 100%;
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-weight: 700;
			color: var(--sl-color-white);
			text-decoration: none;
		}

		.brand-mark {
			width: 0.7rem;
			height: 0.7rem;
			background: #4f6ef7;
			flex-shrink: 0;
		}

		.brand-role {
			font-weight: 400;
			color: var(--sl-color-gray-2);
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.tabs {
			display: flex;
			gap: 0.25rem;
			flex-wrap: wrap;
		}

		.tabs a {
			display: inline-block;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			font-size: 0.85rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			padding: 0.4rem 0.7rem;
			border-radius: 999px;
			transition:
				background-color 0.15s ease,
				color 0.15s ease;
		}

		.tabs a:hover {
			color: var(--sl-color-white);
			background: var(--sl-color-accent-low);
		}

		.tabs a[aria-current='page'] {
			color: #4f6ef7;
			font-weight: 600;
			background: var(--sl-color-accent-low);
		}
	}
</style>
