<button class="print-btn" data-pagefind-ignore onclick="window.print()">Download as PDF ↓</button>

<style>
	:global(.sl-container:has(.resume-body)) {
		max-width: 64rem;
	}

	.print-btn {
		font-family: var(--sl-font);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.6rem 1.4rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		color: var(--sl-color-accent);
		background: transparent;
		cursor: pointer;
		float: right;
	}

	.print-btn:hover {
		background: var(--sl-color-accent-low);
	}
</style>
